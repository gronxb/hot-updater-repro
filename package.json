{
	"name": "gym-app",
	"main": "index.ts",
	"version": "1.0.700",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"prebuild": "expo prebuild --clean",
		"lint": "expo lint",
		"commit": "cz",
		"postinit": "pnpm husky install",
		"ai": "node ./aiScript",
		"typecheck": "tsc --noEmit",
		"format:check": "pnpm prettier --check .",
		"format:fix": "pnpm prettier --write .",
		"reset:build": "rm -rf .expo android ios node_modules && pnpm install && pnpm expo prebuild --clean",
		"prepare": "command -v husky >/dev/null 2>&1 && husky install || true",
		"fp": "hot-updater fingerprint create"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"lint-staged": {
		"src/app/**/*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{js,ts,json,md}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@expo/vector-icons": "^14.1.0",
		"@hot-updater/react-native": "0.20.9",
		"@react-navigation/bottom-tabs": "^7.3.10",
		"@react-navigation/elements": "^2.6.4",
		"@react-navigation/native": "^7.1.6",
		"@sentry/react-native": "~6.14.0",
		"@tanstack/react-form": "^1.19.4",
		"@tanstack/react-query": "^5.87.1",
		"expo": "~53.0.22",
		"expo-blur": "~14.1.5",
		"expo-constants": "~17.1.7",
		"expo-dev-client": "^5.2.4",
		"expo-font": "~13.3.2",
		"expo-haptics": "~14.1.4",
		"expo-image": "~2.4.0",
		"expo-linking": "~7.1.7",
		"expo-router": "~5.1.5",
		"expo-splash-screen": "~0.30.10",
		"expo-status-bar": "~2.2.3",
		"expo-symbols": "~0.4.5",
		"expo-system-ui": "~5.0.11",
		"expo-updates": "~0.28.17",
		"expo-web-browser": "~14.2.0",
		"html": "^1.0.0",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"react-form-hook": "^0.0.1",
		"react-hook-form": "^7.62.0",
		"react-native": "0.79.5",
		"react-native-edge-to-edge": "1.6.0",
		"react-native-gesture-handler": "~2.24.0",
		"react-native-nitro-modules": "^0.29.3",
		"react-native-reanimated": "3.17.5",
		"react-native-safe-area-context": "5.4.0",
		"react-native-screens": "~4.11.1",
		"react-native-svg": "15.11.2",
		"react-native-unistyles": "^3.0.11",
		"react-native-web": "~0.20.0",
		"react-native-webview": "13.13.5",
		"zod": "^4.1.5"
	},
	"devDependencies": {
		"@babel/core": "^7.28.4",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@hot-updater/cloudflare": "0.20.9",
		"@hot-updater/expo": "0.20.9",
		"@sentry/cli": "^2.53.0",
		"@tanstack/eslint-plugin-query": "^5.86.0",
		"@types/react": "~19.0.14",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"dotenv": "^17.2.2",
		"eslint": "^9.35.0",
		"eslint-config-expo": "~9.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"globals": "^16.3.0",
		"hot-updater": "^0.20.9",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.6",
		"madge": "^8.0.0",
		"prettier": "^3.6.2",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.42.0",
		"wrangler": "^4.34.0"
	},
	"private": true,
	"packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@sentry/cli",
			"react-native-nitro-modules"
		]
	}
}
